{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dracoria-thirdweb",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "dracoria.org/*", "zone_name": "dracoria.org" }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
