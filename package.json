{
  "name": "dracoria-thirdweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "npm run build:cloudflare",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "node scripts/check-build-env.mjs && vite build && node scripts/write-deployment.mjs dist/client",
    "check:deploy": "npm run build:cloudflare && wrangler deploy --dry-run",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.1.0",
    "@x402/evm": "2.28.0",
    "bulma": "1.0.0",
    "next": "16.4.3",
    "pino-pretty": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "server-only": "0.0.1",
    "thirdweb": "5.121.6",
    "vinext": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.29",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vite-css-modules": "1.16.0",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "fflate@>=0.7.0 <0.7.5": "0.7.5",
    "js-yaml": "4.3.2",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "ws@>=8.0.0 <8.21.0": "8.21.0"
  }
}
